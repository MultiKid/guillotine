{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": ".server-build",
    "rootDir": ".",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false
  },
  "include": ["server/**/*.ts", "lib/cards/**/*.ts", "lib/game/**/*.ts"],
  "exclude": ["node_modules", ".next", ".server-build"]
}
